# Host-side config for scripts/refresh_db.sh (task db:refresh).
#
# Separate from .env on purpose: .env is parsed by app/config.py's pydantic
# Settings, which rejects unknown keys, so BACKUP_SSH in there would stop the
# app booting. The script runs on the host and reads this file; the app never
# sees it.
#
# Copy to .env.local (gitignored) and fill in BACKUP_SSH.

# Required: ssh destination of the Hetzner Storage Box the nightly backups go to
# (docs/backup-setup.md). An ~/.ssh/config alias works; Storage Boxes listen on
# port 23, so the alias is the easy way to carry that.
BACKUP_SSH=

# Optional: where the dailies live on the Storage Box, relative to its home.
# BACKUP_PATH=backups/boone-gifts/daily

# Optional: the local database file, matching APP_DATABASE_URL in .env.
# LOCAL_DB=data/boone_gifts.db
