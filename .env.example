# Database
APP_DATABASE_URL=sqlite:///./data/boone_gifts.db
APP_TEST_DATABASE_URL=sqlite:///./data/boone_gifts_test.db

# Auth — generate with: openssl rand -hex 32
APP_JWT_SECRET=

# CORS — JSON array of allowed origins
APP_CORS_ORIGINS=["https://boone-gifts.localhost"]

# Frontend URL — used in email links
APP_FRONTEND_URL=https://boone-gifts.localhost

# Email — "log" for local dev (prints to stdout), "smtp" for real delivery
APP_EMAIL_PROVIDER=log
APP_EMAIL_FROM=Boone Gifts <noreply@boone-gifts.localhost>
APP_EMAIL_SMTP_HOST=
APP_EMAIL_SMTP_PORT=587
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_SMTP_USE_TLS=true

# LinkPreview.net — fallback for URL metadata on sites that block direct fetch (optional)
APP_LINKPREVIEW_API_KEY=

# Sentry (optional)
APP_SENTRY_DSN=
APP_SENTRY_ENVIRONMENT=development
APP_SENTRY_RELEASE=
