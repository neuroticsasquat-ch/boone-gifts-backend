# Database
APP_DATABASE_URL=sqlite:///./data/boone_gifts.db
APP_TEST_DATABASE_URL=sqlite:///./data/boone_gifts_test.db

# Auth — generate with: openssl rand -hex 32
APP_JWT_SECRET=

# CORS — JSON array of allowed origins. This is the origin the *browser* loads
# the web app from, which is not where the API lives: locally Traefik serves the
# web app at https://boone-gifts.localhost and this API at
# https://boone-gifts-api.localhost.
APP_CORS_ORIGINS=["https://boone-gifts.localhost"]

# Frontend URL — used in email links, so it must be reachable from wherever the
# recipient opens the mail.
APP_FRONTEND_URL=https://boone-gifts.localhost

# Email — "log" prints to stdout, "smtp" delivers over SMTP, "resend" delivers
# through the Resend HTTP API (production). Locally, smtp goes to the shared
# tbc-localdev-infra Mailpit (tbc_mailpit:1025 on the proxy network, TLS off);
# read the messages at https://mailpit.localhost.
APP_EMAIL_PROVIDER=smtp
# Production sends from the Resend subdomain, e.g. Boone Gifts <info@mail.boone.gift>
APP_EMAIL_FROM=Boone Gifts <info@mail.boone.gift>
# Where replies go — must be a mailbox that receives mail. Empty omits the Reply-To header.
APP_EMAIL_REPLY_TO=
APP_EMAIL_SMTP_HOST=tbc_mailpit
APP_EMAIL_SMTP_PORT=1025
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_SMTP_USE_TLS=false
# Only read when APP_EMAIL_PROVIDER=resend.
APP_RESEND_API_KEY=

# LinkPreview.net — fallback for URL metadata on sites that block direct fetch (optional)
APP_LINKPREVIEW_API_KEY=

# Error reporting (optional)
# Leave APP_SENTRY_DSN empty to disable Sentry in local dev.
APP_SENTRY_DSN=
# Deployment environment, shared by every telemetry consumer (Sentry's environment,
# OTel's deployment.environment). The code default is "production" (see app/config.py).
# APP_SENTRY_ENVIRONMENT is still read as a fallback when this is unset.
APP_ENVIRONMENT=development
# Release tag. Leave empty: it defaults to SOURCE_COMMIT, which Coolify injects in
# production (see docs/runbook.md). Set it only to override the commit SHA.
APP_SENTRY_RELEASE=
