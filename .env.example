# Database
APP_DATABASE_URL=sqlite:///./data/boone_gifts.db
APP_TEST_DATABASE_URL=sqlite:///./data/boone_gifts_test.db

# Auth — generate with: openssl rand -hex 32
APP_JWT_SECRET=

# CORS — JSON array of allowed origins. This is the origin the *browser* loads
# the web app from, which is not necessarily where the API lives: the dev stack
# publishes web on 5173 and api on 8000. On a remote workspace, use the web
# subdomain instead, e.g. ["https://web--<workspace>.<host>"].
APP_CORS_ORIGINS=["http://localhost:5173"]

# Frontend URL — used in email links, so it must be reachable from wherever the
# recipient opens the mail (the web subdomain on a remote workspace).
APP_FRONTEND_URL=http://localhost:5173

# Email — "log" prints to stdout, "smtp" delivers. The dev stack runs Mailpit as
# the `mail` service: set the provider to smtp with host `mail`, port 1025 and
# TLS off, then read the messages at http://localhost:8025.
APP_EMAIL_PROVIDER=log
APP_EMAIL_FROM=Boone Gifts <noreply@boone.gift>
APP_EMAIL_SMTP_HOST=
APP_EMAIL_SMTP_PORT=587
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_SMTP_USE_TLS=true

# LinkPreview.net — fallback for URL metadata on sites that block direct fetch (optional)
APP_LINKPREVIEW_API_KEY=

# Sentry (optional)
# Leave APP_SENTRY_DSN empty to disable Sentry in local dev.
# The code default for the environment tag is "production" (see app/config.py);
# set it to "development" locally only if you actually wire up a DSN.
APP_SENTRY_DSN=
APP_SENTRY_ENVIRONMENT=development
# Release tag for error/trace grouping. In production (Coolify) set this to
# the deploy commit: APP_SENTRY_RELEASE=${SOURCE_COMMIT} (see docs/runbook.md).
APP_SENTRY_RELEASE=
