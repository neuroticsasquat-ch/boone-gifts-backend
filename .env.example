APP_DATABASE_URL=sqlite:////data/boone_gifts.db
APP_TEST_DATABASE_URL=sqlite:////data/boone_gifts_test.db
# Generate with: openssl rand -hex 32
APP_JWT_SECRET=
APP_CORS_ORIGINS=["http://localhost:3000"]

# Frontend base URL used to build links in outbound emails
APP_FRONTEND_URL=https://boone-gifts.localhost

# Email — "log" writes to stdout, "smtp" sends via SMTP (use mailpit:1025 for localdev)
APP_EMAIL_PROVIDER=log
APP_EMAIL_FROM=Boone Gifts <noreply@boone-gifts.localhost>
APP_EMAIL_SMTP_HOST=mailpit
APP_EMAIL_SMTP_PORT=1025
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_SMTP_USE_TLS=false
